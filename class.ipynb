    "#클래스 정의\n",
    "class Monster:\n",
    "    def __init__(self, name):\n",
    "        self.name = name #인스턴스변수\n",
    "    def say(self):\n",
    "        print(f'나는 {self.name}')\n",
    "#객체 생성, 사용\n",
    "shark = Monster('상어')\n",
    "shark.say()"
   ]
  }
